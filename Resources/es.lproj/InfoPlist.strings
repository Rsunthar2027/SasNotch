/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "SasNotch usa Automatización para mover archivos, enviar elementos a la Papelera, abrir los comandos solicitados y controlar la reproducción en tus apps multimedia.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "SasNotch usa el audio de cada app para ajustar su volumen en el mezclador, para mover las barras de música de Dynamic Island y para incluir el sonido del Mac en las grabaciones de pantalla que inicies. Nada sale de tu Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "SasNotch usa Bluetooth solo para leer la batería de los periféricos conectados. Nada sale de tu Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "SasNotch graba tu micrófono solo cuando lo activas para una grabación de pantalla. El audio se queda en tu Mac salvo que elijas crear un enlace temporal.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "SasNotch muestra tu cámara solo en la ventana de vista previa que abres, para que compruebes cómo te ves antes de una llamada. No se graba nada ni nada sale de tu Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "SasNotch consulta metadatos locales en Descargas para revisar, organizar o enviar a la Papelera solo los archivos confirmados de WhatsApp que tú elijas. Limpieza también busca capturas olvidadas si guardas tus capturas aquí.";

